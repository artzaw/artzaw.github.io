{
  "routes": [
    {
      "route": "/picture/*",
      "headers": { "cache-control": "public, max-age=31536000, immutable" }
    },
    {
      "route": "/css/*",
      "headers": { "cache-control": "public, max-age=3600" }
    },
    {
      "route": "/js/*",
      "headers": { "cache-control": "public, max-age=3600" }
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/picture/*", "/css/*", "/js/*"]
  },
  "mimeTypes": {
    ".mp4": "video/mp4"
  }
}
